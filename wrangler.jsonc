{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "irina-xu-portfolio",
  "compatibility_date": "2026-08-13",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "irinaxu.com",
      "custom_domain": true
    },
    {
      "pattern": "www.irinaxu.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
